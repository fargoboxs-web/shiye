# 抄成 .env 再填（.env 不进 git）。用哪个适配器填哪几行，不用的留空。
# 填完跑 python3 run.py adapters 看哪些接上了。

# Get笔记：https://www.biji.com/openapi 建应用后拿到
GETNOTE_API_KEY=
GETNOTE_CLIENT_ID=

# 小红书公开收藏
XHS_PROFILE=            # 主页链接或 24 位用户 ID；收藏要先设成公开
TIKHUB_API_KEY=         # https://tikhub.io ，要充值余额
APIFY_TOKEN=            # 备用路线才要

# 书库 MCP：地址填在 agent 的 MCP 配置里（见 adapters/books-mcp/README.md），key 向维护者要
BOOKS_MCP_KEY=
