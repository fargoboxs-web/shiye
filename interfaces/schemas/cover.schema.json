{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cover.json",
  "type": "object",
  "required": [
    "title"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "description": "刊名，两个汉字"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": "string",
      "description": "封面小字，系列名；不填不印"
    },
    "palette": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "淡紫",
            "芥末黄",
            "灰绿",
            "淡粉"
          ]
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "object",
          "required": [
            "field",
            "shapes"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "shapes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string"
              }
            },
            "ink": {
              "type": "string"
            }
          }
        }
      ]
    },
    "motif": {
      "type": "string",
      "enum": [
        "fan",
        "stack",
        "scatter",
        "svg"
      ],
      "default": "fan"
    },
    "svg": {
      "type": "string",
      "description": "motif 为 svg 时的 SVG 片段，坐标系 148×210"
    },
    "seed": {
      "type": "integer"
    },
    "mast": {
      "type": "string",
      "enum": [
        "kai",
        "song",
        "hei"
      ],
      "default": "kai"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "每篇一个颜色（按篇的顺序），篇首页色块、目录色带用；一般就是封面上用的那几种"
    },
    "paper": {
      "type": "string",
      "description": "封面底色；第一篇篇首页顶上那一条用它"
    },
    "label_colors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "「本期选读」和方案 B 序号的颜色，每篇一个；不填把 layers 自动压暗"
    },
    "style": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ],
      "default": "A",
      "description": "篇首页排法，见 rules/typesetting/divider.md"
    },
    "divider_edge": {
      "type": "string",
      "enum": [
        "straight",
        "wave"
      ],
      "default": "straight",
      "description": "方案 A 篇首页色块的边：straight 直边；wave 波浪边（地层那种封面才用）"
    }
  }
}
