{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cover.json",
  "type": "object",
  "required": [
    "layers",
    "title"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "description": "刊名，两个汉字"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "每篇一个颜色（按篇的顺序），篇首页色块、目录色带用；一般就是封面上用的那几种"
    },
    "paper": {
      "type": "string",
      "description": "封面底色；第一篇篇首页顶上那一条用它"
    },
    "label_colors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "「本期选读」几个小字的颜色，每篇一个；不填把 layers 自动压暗"
    },
    "divider_edge": {
      "type": "string",
      "enum": [
        "straight",
        "wave"
      ],
      "default": "straight",
      "description": "篇首页色块的边：straight 直边；wave 波浪边（地层那种封面才用）"
    }
  }
}
